// ── Default parameters ────────────────────────────────────────────────────────
params {
    batch_dir    = null
    exomiser_jar = "exomiser-cli.jar"
    short_queue  = "short"
    project      = "re_gecip_enhanced_interpretation"
    java_module  = "java/23.0.1"
    nf_module    = "nextflow/25.04.6-with-plugins"
}

// ── Executor: LSF / bsub ──────────────────────────────────────────────────────
executor {
    name = 'lsf'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    executor     = 'lsf'
    queue        = params.short_queue
    memory       = '8 GB'
    cpus         = 1
    module       = params.java_module

    // -P sets the LSF project; span[hosts=1] keeps all slots on one node.
    // Nextflow generates its own -R "rusage[mem=X]" and -M X from the memory
    // directive — this extra -R is ANDed with it by LSF.
    clusterOptions = "-P ${params.project} -R \"span[hosts=1]\""

    // Capture LSF-specific timeout exit codes so Nextflow treats them as
    // retryable rather than fatal failures.
    // 140 = TERM_RUNLIMIT  (job exceeded -W wall-clock limit)
    // 130 = TERM_OWNER     (killed externally, sometimes used by schedulers)
    errorStrategy = 'retry'
    maxRetries = 3
}

// ── Reports ───────────────────────────────────────────────────────────────────
report {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_trace.txt"
    fields    = 'task_id,name,status,exit,attempt,submit,start,complete,duration,realtime,queue,memory,cpu_model'
}
