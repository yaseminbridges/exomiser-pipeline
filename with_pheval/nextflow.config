// ── Default parameters ────────────────────────────────────────────────────────
params {
    exomiser_jar    = "exomiser-cli.jar"
    exomiser_version = "15.0.0"
    short_queue     = "short"
    project         = "re_gecip_enhanced_interpretation"
    java_module        = "java/23.0.1"
    singularity_module = "singularity/4.1.1"
    nf_module          = "nextflow/25.04.6-with-plugins"
}

// ── Executor: LSF / bsub ──────────────────────────────────────────────────────
executor {
    name = 'lsf'
}

// ── Container ─────────────────────────────────────────────────────────────────
singularity {
    enabled    = true
    autoMounts = true
    runOptions = "--bind /nas/weka.gel.zone/re_gecip:/nas/weka.gel.zone/re_gecip --bind /re_gecip:/re_gecip"
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    executor = 'lsf'
    queue    = params.short_queue
    memory   = '8 GB'
    cpus     = 1

    clusterOptions = "-P ${params.project} -R \"span[hosts=1]\""

    errorStrategy = 'retry'
    maxRetries = 3

    withName: 'RUN_EXOMISER' {
        module = params.java_module
    }

    withName: 'PREPARE_BATCHES|POST_PROCESS' {
        memory = '2 GB'
        module = params.singularity_module
    }
}

// ── Reports ───────────────────────────────────────────────────────────────────
report {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_pheval_report.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_pheval_timeline.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "reports/exomiser_pheval_trace.txt"
    fields    = 'task_id,name,status,exit,attempt,submit,start,complete,duration,realtime,queue,memory,cpu_model'
}
